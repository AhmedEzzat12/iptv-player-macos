// Shared build settings for the iOS app. Personal signing values live in Local.xcconfig (git-ignored):
//   cp Config/Local.xcconfig.example Config/Local.xcconfig   then fill in your team ID.
// The real version comes from the repo's VERSION file (Version.xcconfig, written by iOS/scripts/write-version.sh,
// which the build scripts run); these are only fallbacks for a checkout that hasn't run it.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "Version.xcconfig"
// One ID for the iPhone/iPad and Mac App Store apps (Universal Purchase). Local.xcconfig overrides it for
// personal installs.
TUNER_BUNDLE_ID = app.antenna.player
#include? "Local.xcconfig"
