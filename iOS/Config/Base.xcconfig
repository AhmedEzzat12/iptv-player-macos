// Shared build settings for the iOS app. Personal signing values live in Local.xcconfig (git-ignored):
//   cp Config/Local.xcconfig.example Config/Local.xcconfig   then fill in your team ID.
MARKETING_VERSION = 1.1.0
CURRENT_PROJECT_VERSION = 1
// One ID for the iPhone/iPad and Mac App Store apps (Universal Purchase). Local.xcconfig overrides it for
// personal installs.
TUNER_BUNDLE_ID = app.tuner.player
#include? "Local.xcconfig"
